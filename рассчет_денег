SELECT 
    t.ID_Персонал,
    t.ТабНомер_Персонал,	
    t.FIO, 
    t.НаименованиеДолжности_ШТАТ,  
    t.ДолжностьID_ШТАТ,
    
    Sum(t.Утро) AS Утро_ч,
    Sum(t.Ночь) AS Ночь_ч,
    Sum(t.Утро + t.Ночь) AS Всего_ч,
    
    Sum(t.УтроПраздник) AS Утро_праздник_ч,
    Sum(t.НочьПраздник) AS Ночь_праздник_ч,
    Sum(t.УтроПраздник + t.НочьПраздник) AS Всего_Праздник_ч,
    
    Sum(t.УтроВыходной) AS Утро_выходной_ч,
    Sum(t.НочьВыходной) AS Ночь_выходной_ч,
    Sum(t.УтроВыходной + t.НочьВыходной) AS Всего_выходной_ч,    

    IIf(Nz(Max(t.K_Slogn), 0) > 0, "+" & Nz(Max(t.K_Slogn), 0) &"%",'-') As коэффСложн,
    IIf(Nz(Max(t.K_Zona), 0) > 0, "+" & Nz(Max(t.K_Zona), 0) &"%",'-') As коэффЗона,	
    
    IIf(
        Nz([Forms]![фРЕДАКТОР_ТАБЕЛЯ]![Норма_часов], 0) <= 0, 
        '-', 
        IIf(
            Sum(t.Утро + t.Ночь) - Sum(t.УтроВыходной + t.НочьВыходной) - Sum(t.УтроПраздник + t.НочьПраздник) <= Nz([Forms]![фРЕДАКТОР_ТАБЕЛЯ]![Норма_часов], 0),
            '-',
            ROUND(Sum(t.Утро + t.Ночь) - Sum(t.УтроВыходной + t.НочьВыходной) - Sum(t.УтроПраздник + t.НочьПраздник) - Nz([Forms]![фРЕДАКТОР_ТАБЕЛЯ]![Норма_часов], 0), 2)
        )
    ) AS Перераб_ч,

	IIf(
         (Sum(t.Утро) - Sum(t.УтроВыходной) - Sum(t.УтроПраздник)) > Nz([Forms]![фРЕДАКТОР_ТАБЕЛЯ]![Норма_часов], 0),
		  ROUND((Sum(t.Утро) - Sum(t.УтроВыходной) - Sum(t.УтроПраздник)) - Nz([Forms]![фРЕДАКТОР_ТАБЕЛЯ]![Норма_часов], 0), 2),
          0
        ) AS Перераб_Утро,	
	IIf(
    (Sum(t.Утро + t.Ночь) - Sum(t.УтроВыходной + t.НочьВыходной) - Sum(t.УтроПраздник + t.НочьПраздник)) > Nz([Forms]![фРЕДАКТОР_ТАБЕЛЯ]![Норма_часов], 0),
    ROUND( 
          (Sum(t.Утро + t.Ночь) - Sum(t.УтроВыходной + t.НочьВыходной) - Sum(t.УтроПраздник + t.НочьПраздник)) 
           - IIf((Sum(t.Утро) - Sum(t.УтроВыходной) - Sum(t.УтроПраздник)) > Nz([Forms]![фРЕДАКТОР_ТАБЕЛЯ]![Норма_часов], 0), 
                 (Sum(t.Утро) - Sum(t.УтроВыходной) - Sum(t.УтроПраздник)), 
                  Nz([Forms]![фРЕДАКТОР_ТАБЕЛЯ]![Норма_часов], 0)), 
           2),
           0
        ) AS Перераб_Ночь,
	
    
    Sum(IIf(t.Тариф <= 1000, ((t.Утро + t.Ночь) - (t.УтроВыходной + t.НочьВыходной)) * t.Тариф, 0)) + Max(IIf(t.Тариф > 1000, IIf(((t.Утро + t.Ночь) - (t.УтроВыходной + t.НочьВыходной)) > 0, t.Тариф, 0), 0)) 
	    AS Оплата_тарифРУБ,    
    (Sum(IIf(t.Тариф <= 1000, ((t.Утро + t.Ночь) - (t.УтроВыходной + t.НочьВыходной)) * t.Тариф, 0))+ Max(IIf(t.Тариф > 1000, IIf(((t.Утро + t.Ночь) - (t.УтроВыходной + t.НочьВыходной)) > 0, t.Тариф, 0), 0))) * Nz(Max(t.K_Vred), 0) / 100 
        AS Оплата_ВиОУТ_РУБ,    
    ((Sum(IIf(t.Тариф <= 1000, ((t.Утро + t.Ночь) - (t.УтроВыходной + t.НочьВыходной)) * t.Тариф, 0)) + Max(IIf(t.Тариф > 1000, t.Тариф, 0))) + 
    ((Sum(IIf(t.Тариф <= 1000, ((t.Утро + t.Ночь) - (t.УтроВыходной + t.НочьВыходной)) * t.Тариф, 0)) + Max(IIf(t.Тариф > 1000, t.Тариф, 0))) * Nz(Max(t.K_Vred), 0) / 100)) * Nz(Max(t.K_Slogn), 0) / 100 
        AS Оплата_Сложн_РУБ,    
    ((Sum(IIf(t.Тариф <= 1000, ((t.Утро + t.Ночь) - (t.УтроВыходной + t.НочьВыходной)) * t.Тариф, 0)) + Max(IIf(t.Тариф > 1000, t.Тариф, 0))) + 
    ((Sum(IIf(t.Тариф <= 1000, ((t.Утро + t.Ночь) - (t.УтроВыходной + t.НочьВыходной)) * t.Тариф, 0)) + Max(IIf(t.Тариф > 1000, t.Тариф, 0))) * Nz(Max(t.K_Vred), 0) / 100) + 
    (((Sum(IIf(t.Тариф <= 1000, ((t.Утро + t.Ночь) - (t.УтроВыходной + t.НочьВыходной)) * t.Тариф, 0)) + Max(IIf(t.Тариф > 1000, t.Тариф, 0))) + 
    ((Sum(IIf(t.Тариф <= 1000, ((t.Утро + t.Ночь) - (t.УтроВыходной + t.НочьВыходной)) * t.Тариф, 0)) + Max(IIf(t.Тариф > 1000, t.Тариф, 0))) * Nz(Max(t.K_Vred), 0) / 100)) * Nz(Max(t.K_Slogn), 0) / 100)) * Nz(Max(t.K_Zona), 0) / 100 
        AS Оплата_РасшЗоны_РУБ,        
    Sum( (t.УтроПраздник + t.НочьПраздник) * 
        IIf(t.Тариф <= 1000, t.Тариф, 0) * 
        (1 + Nz(t.K_Vred, 0) / 100) * 
        (1 + Nz(t.K_Slogn, 0) / 100) * 
        (1 + Nz(t.K_Zona, 0) / 100) ) 
		AS Оплата_ПраздРУБ,		
    Sum(t.Ночь*IIf(t.Тариф<=1000,t.Тариф,0)*Nz(t.K_Noch,0)/100*(1+Nz(t.K_Vred,0)/100)*(1+Nz(t.K_Slogn,0)/100)) 
	    AS Оплата_НочьРУБ, 
    Sum((t.УтроВыходной + t.НочьВыходной) * IIf(t.Тариф <= 1000, t.Тариф, t.Тариф/Nz(Forms!фРЕДАКТОР_ТАБЕЛЯ!Норма_часов, t.Тариф))
        * (1+Nz(t.K_Vred,0)/100)*(1+Nz(t.K_Slogn,0)/100) *(1+Nz(t.K_Zona,0)/100) *2) 
		AS Оплата_ВыходнРУБ,
 
 
    (Оплата_тарифРУБ + Оплата_ВиОУТ_РУБ + Оплата_Сложн_РУБ + Оплата_РасшЗоны_РУБ + Оплата_НочьРУБ + Оплата_ВыходнРУБ) AS Итого_Оплата_РУБ

FROM (
    SELECT 
        Ч.ID_Персонал, (П.Фамилия_Персонал & " " & Left(П.Имя_Персонал, 1) & "." & Left(Отчество_Персонал, 1)& ".") AS FIO, 
        П.ТабНомер_Персонал,
        Ш.НаименованиеДолжности_ШТАТ, 
        Ш.ДолжностьID_ШТАТ,
        Ч.Утро, Ч.Ночь, Ч.УтроВыходной, Ч.НочьВыходной, Ч.УтроПраздник, Ч.НочьПраздник, ИТ.Тариф, Ч.Дата_Табель,

        
        Nz((SELECT Sum(Значение) FROM тИСТОРИЯ_КОЭФФИЦИЕНТОВ WHERE ID_Штат = Ш.ID_Штат AND ID_ТипКоэф = 1 AND Ч.Дата_Табель BETWEEN ДатаНачала AND Nz(ДатаОкончания, #01/01/9999#)), 0) AS K_Vred,
		Nz((SELECT Sum(Значение) FROM тИСТОРИЯ_КОЭФФИЦИЕНТОВ WHERE ID_Штат = Ш.ID_Штат AND ID_ТипКоэф = 2 AND Ч.Дата_Табель BETWEEN ДатаНачала AND Nz(ДатаОкончания, #01/01/9999#)), 0) AS K_Noch, 
        Nz((SELECT Sum(Значение) FROM тИСТОРИЯ_КОЭФФИЦИЕНТОВ WHERE ID_Штат = Ш.ID_Штат AND ID_ТипКоэф = 3 AND Ч.Дата_Табель BETWEEN ДатаНачала AND Nz(ДатаОкончания, #01/01/9999#)), 0) AS K_Slogn,
        Nz((SELECT Sum(Значение) FROM тИСТОРИЯ_КОЭФФИЦИЕНТОВ WHERE ID_Штат = Ш.ID_Штат AND ID_ТипКоэф = 4 AND Ч.Дата_Табель BETWEEN ДатаНачала AND Nz(ДатаОкончания, #01/01/9999#)), 0) AS K_Zona,
        Nz((SELECT Sum(Значение) FROM тИСТОРИЯ_КОЭФФИЦИЕНТОВ WHERE ID_Штат = Ш.ID_Штат AND ID_ТипКоэф = 5 AND Ч.Дата_Табель BETWEEN ДатаНачала AND Nz(ДатаОкончания, #01/01/9999#)), 0) AS K_Prem

    FROM ((((зпр_Часы_По_Дням AS Ч 
    INNER JOIN тПЕРСОНАЛ AS П ON Ч.ID_Персонал = П.ID_Персонал) 
    INNER JOIN тНАЗНАЧЕНИЕ_ДОЛЖНОСТИ AS НД ON Ч.ID_Персонал = НД.ID_Персонал) 
    INNER JOIN тШтат AS Ш ON НД.ID_Штат = Ш.ID_Штат) 
    INNER JOIN тИСТОРИЯ_ТАРИФОВ AS ИТ ON Ш.ID_Штат = ИТ.ID_Штат)
    
    WHERE (ИТ.Разряд = НД.РазрядПоОплате)
      AND (Ч.Дата_Табель BETWEEN НД.ДатаНачала AND Nz(НД.ДатаОкончания, #01/01/9999#))
      AND (Ч.Дата_Табель BETWEEN ИТ.ДатаНачала AND Nz(ИТ.ДатаОкончания, #01/01/9999#))
) AS t
GROUP BY t.ID_Персонал, t.НаименованиеДолжности_ШТАТ,t.ДолжностьID_ШТАТ, t.ТабНомер_Персонал, FIO;
