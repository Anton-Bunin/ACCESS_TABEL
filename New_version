'####################    зпр_Часы_По_Дням   v.2'
SELECT 
    T.ID_Персонал, 
    T.Дата_Табель,

    Sum(IIf(T.Код_Табель='У', T.Часы_Табель, 0)) AS Утро,
    Sum(IIf(T.Код_Табель='Н', T.Часы_Табель, 0)) AS Ночь,	
	
    Sum(IIf(T.Код_Табель='У' AND T.Работа_в_выходной = True, T.Часы_Табель, 0)) AS УтроВыходной,
    Sum(IIf(T.Код_Табель='Н' AND T.Работа_в_выходной = True, T.Часы_Табель, 0)) AS НочьВыходной
	
    Sum(IIf(T.Код_Табель='У' AND T.Работа_в_выходной = False AND T.Работа_в_праздник = True, T.Часы_Табель, 0)) AS УтроПраздник,
    Sum(IIf(T.Код_Табель='Н' AND T.Работа_в_выходной = False AND T.Работа_в_праздник = True, T.Часы_Табель, 0)) AS НочьПраздник		
	
FROM тТАБЕЛЬ AS T
WHERE 
    (((T.ID_Период)=[Формы]![фРЕДАКТОР_ТАБЕЛЯ]![Период]))
GROUP BY T.ID_Персонал, T.Дата_Табель;

'####################    зпр_Часы_По_Дням   v.2'



'####################    зпр_ПРОМЕЖУТОЧНЫЙ'
SELECT 
    t.ID_Персонал, 
    t.Фамилия_Персонал, 
    t.Имя_Персонал, 
    t.НаименованиеДолжности_ШТАТ, 
   
    Sum(t.Утро) AS Утро_ч,
    Sum(t.Ночь) AS Ночь_ч,	
    Sum(t.Утро + t.Ночь) AS Всего_ч,	
    
	Sum(t.УтроПраздник) AS Утро_праздник_ч,
    Sum(t.НочьПраздник) AS Ночь_праздник_ч,	
    Sum(t.УтроПраздник + t.НочьПраздник) AS Всего_Праздник_ч,
   
    Sum(t.УтроВыходной) AS Утро_выходной_ч,
    Sum(t.НочьВыходной) AS Ночь_выходной_ч,	
    Sum(t.УтроВыходной + t.НочьВыходной) AS Всего_выходной_ч,
	
	Max(t.Тариф) as Тариф,
	Max(t.K_Vred) as заВред,
	Max(t.K_Zona) as заРасшир,
	Max(K_Slogn) as заСложн,
	Max(K_Prem) as Премия,	

FROM (
    SELECT 
        Ч.ID_Персонал, П.Фамилия_Персонал, П.Имя_Персонал, Ш.НаименованиеДолжности_ШТАТ,
        Ч.Утро, Ч.Ночь, Ч.УтроВыходной, Ч.НочьВыходной, Ч.УтроПраздник, Ч.НочьПраздник, ИТ.Тариф, 

	Nz(К_Прем.Значение, 0) AS K_Prem,
	Nz(К_Вред.Значение, 0) AS K_Vred,
	Nz(К_Сложн.Значение, 0) AS K_Slogn,
	Nz(К_РасшЗоны.Значение, 0) AS K_Zona
        
    FROM ((((((((зпр_Часы_По_Дням AS Ч 
    INNER JOIN тПЕРСОНАЛ AS П ON Ч.ID_Персонал = П.ID_Персонал) 
    INNER JOIN тНАЗНАЧЕНИЕ_ДОЛЖНОСТИ AS НД ON Ч.ID_Персонал = НД.ID_Персонал) 
    INNER JOIN тШтат AS Ш ON НД.ID_Штат = Ш.ID_Штат) 
    INNER JOIN тИСТОРИЯ_ТАРИФОВ AS ИТ ON Ш.ID_Штат = ИТ.ID_Штат) 
    LEFT JOIN тИСТОРИЯ_КОЭФФИЦИЕНТОВ AS К_Ночь ON Ш.ID_Штат = К_Ночь.ID_Штат) 
    LEFT JOIN тИСТОРИЯ_КОЭФФИЦИЕНТОВ AS К_Прем ON Ш.ID_Штат = К_Прем.ID_Штат) 
    LEFT JOIN тИСТОРИЯ_КОЭФФИЦИЕНТОВ AS К_Вред ON Ш.ID_Штат = К_Вред.ID_Штат)
    LEFT JOIN тИСТОРИЯ_КОЭФФИЦИЕНТОВ AS К_Сложн ON Ш.ID_Штат = К_Сложн.ID_Штат)
    LEFT JOIN тИСТОРИЯ_КОЭФФИЦИЕНТОВ AS К_РасшЗоны ON Ш.ID_Штат = К_РасшЗоны.ID_Штат
      
    WHERE (ИТ.Разряд = НД.РазрядПоОплате)
      AND (К_Ночь.ID_ТипКоэф = 2 OR К_Ночь.ID_ТипКоэф Is Null)
      AND (К_Прем.ID_ТипКоэф = 5 OR К_Прем.ID_ТипКоэф Is Null)
      AND (К_Вред.ID_ТипКоэф = 1 OR К_Вред.ID_ТипКоэф Is Null)
      AND (К_Сложн.ID_ТипКоэф = 3 OR К_Сложн.ID_ТипКоэф Is Null)
      AND (К_РасшЗоны.ID_ТипКоэф = 4 OR К_РасшЗоны.ID_ТипКоэф Is Null)
      
      AND (Ч.Дата_Табель BETWEEN НД.ДатаНачала AND Nz(НД.ДатаОкончания, #01/01/9999#))
      AND (Ч.Дата_Табель BETWEEN ИТ.ДатаНачала AND Nz(ИТ.ДатаОкончания, #01/01/9999#))
      AND (Ч.Дата_Табель BETWEEN К_Ночь.ДатаНачала AND Nz(К_Ночь.ДатаОкончания, #01/01/9999#) OR К_Ночь.ID_Штат Is Null)
      AND (Ч.Дата_Табель BETWEEN К_Прем.ДатаНачала AND Nz(К_Прем.ДатаОкончания, #01/01/9999#) OR К_Прем.ID_Штат Is Null)
      AND (Ч.Дата_Табель BETWEEN К_Сложн.ДатаНачала AND Nz(К_Сложн.ДатаОкончания, #01/01/9999#) OR К_Сложн.ID_Штат Is Null)
      AND (Ч.Дата_Табель BETWEEN К_РасшЗоны.ДатаНачала AND Nz(К_РасшЗоны.ДатаОкончания, #01/01/9999#) OR К_РасшЗоны.ID_Штат Is Null)	  
) AS t
GROUP BY t.ID_Персонал, t.Фамилия_Персонал, t.Имя_Персонал, t.НаименованиеДолжности_ШТАТ;
'####################    зпр_ПРОМЕЖУТОЧНЫЙ'


SELECT  '####################    зпр_РАСЧЕТНЫЙ'
    P.*,  

   -- 1. Вспомогательные расчетные поля
    ([Утро_ч] - [Утро_праздник_ч] - [Утро_выходной_ч]) AS Чистое_Утро,
    ([Ночь_ч] - [Ночь_праздник_ч] - [Ночь_выходной_ч]) AS Чистая_Ночь,
    IIf([Тариф] <= 1000, [Тариф], [Тариф] / Nz([Forms]![фРЕДАКТОР_ТАБЕЛЯ]![Норма_часов], 1)) AS Часовая_Ставка,
    ((1 + Nz([заВред],0)/100) * (1 + Nz([заСложн],0)/100) * (1 + Nz([заРасшир],0)/100)) AS Коэф_Всего,

    -- 2. Разделение переработки в ЧАСАХ
    IIf([Чистое_Утро] > Nz([Forms]![фРЕДАКТОР_ТАБЕЛЯ]![Норма_часов], 0), 
        [Чистое_Утро] - Nz([Forms]![фРЕДАКТОР_ТАБЕЛЯ]![Норма_часов], 0), 0) AS Перераб_Утро_ч,

    IIf(([Чистое_Утро] + [Чистая_Ночь]) > Nz([Forms]![фРЕДАКТОР_ТАБЕЛЯ]![Норма_часов], 0), 
        ([Чистое_Утро] + [Чистая_Ночь]) - IIf([Чистое_Утро] > Nz([Forms]![фРЕДАКТОР_ТАБЕЛЯ]![Норма_часов], 0), [Чистое_Утро], Nz([Forms]![фРЕДАКТОР_ТАБЕЛЯ]![Норма_часов], 0)), 
        0) AS Перераб_Ночь_ч,

    -- 3. РАСЧЕТ ДЕНЕГ (РУБ)
 	  -- Доплата только за ВРЕДНОСТЬ (на чистую ставку)
    ROUND([Перераб_Утро_ч] * [Часовая_Ставка] * ([заВред] / 100), 2) 
	     AS Доплата_Вред_РУБ,
    -- Доплата за СЛОЖНОСТЬ (на ставку + вредность)
    ROUND(
        ([Перераб_Утро_ч] * [Часовая_Ставка] * (1 + [заВред] / 100))* ([заСложн] / 100), 2) 
		AS Доплата_Сложн_РУБ,
    -- Доплата за ЗОНУ (на ставку + вредность + сложность)
    ROUND(
        ([Перераб_Утро_ч] * [Часовая_Ставка] * (1 + [заВред] / 100) * (1 + [заСложн] / 100))* ([заРасшир] / 100), 2
         ) AS Доплата_Зона_РУБ   
	
	
	
	
	-- Оплата переработки УТРО (коэф 1.5 за первые 2 часа обычно опустим, если считаем по среднему)
    ROUND([Перераб_Утро_ч] * [Часовая_Ставка] * [Коэф_Всего], 2) AS Оплата_Перераб_Утро_РУБ,

    -- Оплата переработки НОЧЬ (+40% ночных включено в расчет)
    ROUND([Перераб_Ночь_ч] * [Часовая_Ставка] * [Коэф_Всего] * 1.4, 2) AS Оплата_Перераб_Ночь_РУБ,

    -- Праздничные (в двойном размере как на GitHub)
    ROUND(([Утро_праздник_ч] + [Ночь_праздник_ч]) * [Часовая_Ставка] * [Коэф_Всего] * 2, 2) 
	      AS Оплата_Праздник_РУБ
		  


FROM зпр_ПРОМЕЖУТОЧНЫЙ AS P;
